#!/bin/sh
basedir=$(dirname "$(echo "$0" | sed -e 's,\\,/,g')")

case `uname` in
    *CYGWIN*|*MINGW*|*MSYS*)
        if command -v cygpath > /dev/null 2>&1; then
            basedir=`cygpath -w "$basedir"`
        fi
    ;;
esac

if [ -z "$NODE_PATH" ]; then
  export NODE_PATH="/home/runner/work/add-component-class/add-component-class/node_modules/.pnpm/release-plan@0.18.0/node_modules/release-plan/node_modules:/home/runner/work/add-component-class/add-component-class/node_modules/.pnpm/release-plan@0.18.0/node_modules:/home/runner/work/add-component-class/add-component-class/node_modules/.pnpm/node_modules"
else
  export NODE_PATH="/home/runner/work/add-component-class/add-component-class/node_modules/.pnpm/release-plan@0.18.0/node_modules/release-plan/node_modules:/home/runner/work/add-component-class/add-component-class/node_modules/.pnpm/release-plan@0.18.0/node_modules:/home/runner/work/add-component-class/add-component-class/node_modules/.pnpm/node_modules:$NODE_PATH"
fi
if [ -x "$basedir/node" ]; then
  exec "$basedir/node"  "$basedir/../.pnpm/release-plan@0.18.0/node_modules/release-plan/dist/cli.js" "$@"
else
  exec node  "$basedir/../.pnpm/release-plan@0.18.0/node_modules/release-plan/dist/cli.js" "$@"
fi
